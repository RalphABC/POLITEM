# Copie este archivo como .env y ajuste lo que necesite.
CIUDAD=Riobamba
ACTA_SECUENCIA_INICIAL=1          # p. ej. 524 para continuar la numeración real

# --- RAG: base vectorial y embeddings ---
VECTOR_STORE=auto                 # auto (Chroma si está instalado) | chroma | memoria
EMBEDDING_PROVIDER=hash           # hash (léxico, sin descargas) | ollama (semántico; requiere Ollama)
OLLAMA_EMBED_MODEL=nomic-embed-text
TOP_K=12
CONTEXTO_MAX_BIENES=40

# --- Generación del texto ---
LLM_PROVIDER=plantilla            # plantilla | ollama | anthropic | openai
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
